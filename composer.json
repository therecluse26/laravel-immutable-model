{
    "name": "brighten/immutable-model",
    "description": "An Eloquent-compatible, read-only model kernel for Laravel 11+",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "TheRecluse26",
            "email": "therecluse26@protonmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^11.5.50|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Brighten\\ImmutableModel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Brighten\\ImmutableModel\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse",
        "bench": "php -d opcache.enable_cli=1 -d memory_limit=-1 benchmarks/read-benchmark.php"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "keywords": [
        "laravel",
        "eloquent",
        "immutable",
        "readonly",
        "model"
    ],
    "homepage": "https://github.com/therecluse26/laravel-immutable-model",
    "support": {
        "issues": "https://github.com/therecluse26/laravel-immutable-model/issues",
        "source": "https://github.com/therecluse26/laravel-immutable-model"
    },
    "config": {
        "sort-packages": true
    }
}
